//PAYJOB   JOB (PAY,456),'PAYROLL RUN',
//             CLASS=B,MSGCLASS=A,NOTIFY=&SYSUID,
//             RESTART=STEP2
//*
//* PAYROLL JCL WITH IF-THEN-ELSE
//*
//STEP1   EXEC PGM=PAYCALC
//PAYFILE  DD  DSN=PAYROLL.DATA.INPUT,DISP=SHR
//RPTFILE  DD  DSN=PAYROLL.REPORTS,DISP=(NEW,CATLG)
//SYSOUT   DD  SYSOUT=*
//*
//IF1     IF (STEP1.RC = 0) THEN
//STEP2   EXEC PGM=PAYTAX
//TAXFILE  DD  DSN=PAYROLL.TAX.DATA,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//        ENDIF
//*
//STEP3   EXEC PGM=IEBGENER
//SYSCOPY  DD  DSN=PAYROLL.ARCHIVE,DISP=(NEW,CATLG)
//SYSUT1   DD  DSN=PAYROLL.REPORTS,DISP=SHR
//SYSUT2   DD  DSN=PAYROLL.ARCHIVE.REPORT,DISP=(NEW,CATLG)
