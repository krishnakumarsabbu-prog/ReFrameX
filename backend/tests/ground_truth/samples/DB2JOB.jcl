//DB2JOB   JOB (DB2,789),'DB2 MAINTENANCE',
//             CLASS=C,MSGCLASS=H,TIME=(0,30),REGION=4096K
//*
//* DB2 UTILITY JCL
//*
//STEP1   EXEC PGM=DSNUTILB,PARM='DSN1,REORG'
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  REORG TABLESPACE DB1.TS1
//STEP2   EXEC PGM=IKJEFT01
//SYSTSIN  DD  *
  DSN SYSTEM(DSN1)
  RUN PROGRAM(DSNTIAUL) PLAN(DSNTIA10) -
       LIBRARY('DSN1.RUNLIB.LOAD')
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
