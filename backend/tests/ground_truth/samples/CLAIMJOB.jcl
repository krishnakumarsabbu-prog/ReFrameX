//CLAIMJOB  JOB (ACCT,123),'CLAIMS PROCESSING',
//             CLASS=A,MSGCLASS=H,NOTIFY=&SYSUID
//*
//* SAMPLE JCL FOR REFRAMEX INGESTION TESTING
//*
//STEP1   EXEC PGM=CLAIMCTL
//STEPLIB  DD  DSN=CLAIMS.LOADLIB,DISP=SHR
//CLMFILE  DD  DSN=CLAIMS.DATA.INPUT,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//STEP2   EXEC PGM=SORT
//SORTIN   DD  DSN=CLAIMS.SORTED.INPUT,DISP=SHR
//SORTOUT  DD  DSN=&&SORTOUT,DISP=(NEW,PASS),UNIT=SYSDA,
//             SPACE=(CYL,(10,5),RLSE)
//SYSIN    DD  *
  SORT FIELDS=(1,8,A),FORMAT=BI
//STEP3   EXEC PROC=REPORTS
//RPTFILE  DD  DSN=CLAIMS.REPORTS.OUTPUT,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(TRK,(5,2))
//SYSIN    DD  *
  GENERATE
/*
