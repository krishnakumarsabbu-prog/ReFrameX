//ACCTJOB   JOB (ACCT,789),'ACCOUNT LEDGER',
//             CLASS=B,MSGCLASS=H,NOTIFY=&SYSUID
//*
//* SYNTHETIC fixture JCL — complex batch with proc and DB2.
//*
//STEP1   EXEC PGM=ACCTLEDG
//STEPLIB  DD  DSN=ACCT.LOADLIB,DISP=SHR
//ACCTFILE DD  DSN=ACCT.MASTER.VSAM,DISP=SHR
//RPTFILE  DD  DSN=ACCT.REPORT.OUTPUT,DISP=(NEW,CATLG),
//             UNIT=SYSDA,SPACE=(CYL,(20,5),RLSE)
//SYSOUT   DD  SYSOUT=*
//STEP2   EXEC PROC=ACCTPROC
//INPUT    DD  DSN=ACCT.TRANSACTIONS.DAILY,DISP=SHR
//OUTPUT   DD  DSN=ACCT.TRANSACTIONS.PROCESSED,DISP=(NEW,PASS),
//             UNIT=SYSDA,SPACE=(CYL,(15,5),RLSE)
//STEP3   EXEC PGM=VALIDATE
//STEPLIB  DD  DSN=ACCT.LOADLIB,DISP=SHR
//*
//* DB2 bind step
//*
//DB2BIND EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2A)
  RUN PROGRAM(ACCTLEDG) PLAN(ACCTPLAN)
/*
