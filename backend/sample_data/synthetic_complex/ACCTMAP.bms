 ACCTMAP  DFHMDI SIZE=(24,80),CTRL=(FREEKB,FRSET),MAPATTS=(COLOR,HILIGHT)
         DFHMSD TYPE=MAP,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
*
*        SYNTHETIC fixture BMS map — account inquiry screen
*
 ACCTMAP  DFHMDI SIZE=(24,80)
 TITLE    DFHMDF POS=(1,30),LENGTH=20,ATTRB=(PROT,NORM),
                INITIAL='ACCOUNT INQUIRY'
 ACCTNUM  DFHMDF POS=(3,10),LENGTH=10,ATTRB=(UNPROT,ICUR),
                INITIAL='__________'
 ACCTNAME DFHMDF POS=(5,10),LENGTH=35,ATTRB=(PROT,NORM)
 ACCTBAL  DFHMDF POS=(7,10),LENGTH=15,ATTRB=(PROT,NORM)
 ACCTSTAT DFHMDF POS=(9,10),LENGTH=1,ATTRB=(PROT,NORM)
 MSGLINE  DFHMDF POS=(23,1),LENGTH=79,ATTRB=(PROT,NORM)
         DFHMSD TYPE=FINAL
