-- SYNTHETIC fixture — RACF security resource definitions
RDEFINE FACILITY (ACCT.UPDT.ACCTLEDG) UACC(NONE)
RDEFINE FACILITY (ACCT.INQR.ACCTLEDG) UACC(READ)
RDEFINE FACILITY (ACCT.RPT.ACCTLEDG) UACC(READ)
RALTER FACILITY (ACCT.UPDT.ACCTLEDG) -
    NOTIFY(ACCTADM) -
    AUDIT(ALL(UPDATE))
PERMIT (ACCT.UPDT.ACCTLEDG) CLASS(FACILITY) ID(ACCTUPDT) ACCESS(UPDATE)
PERMIT (ACCT.INQR.ACCTLEDG) CLASS(FACILITY) ID(ACCTINQR) ACCESS(READ)
