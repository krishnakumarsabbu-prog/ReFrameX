-- SYNTHETIC fixture DDL — not a real Wells Fargo artifact.
CREATE TABLE PAYROLL.EMPLOYEE_PAY (
    EMP_ID      CHAR(6)     NOT NULL,
    EMP_NAME    VARCHAR(30) NOT NULL,
    GROSS_PAY   DECIMAL(9,2),
    NET_PAY     DECIMAL(9,2),
    PAY_DATE    DATE,
    PRIMARY KEY (EMP_ID)
);

CREATE TABLE PAYROLL.PAY_HISTORY (
    HIST_ID     CHAR(10)    NOT NULL,
    EMP_ID      CHAR(6)     NOT NULL,
    PAY_PERIOD  CHAR(6),
    GROSS_AMT   DECIMAL(9,2),
    NET_AMT     DECIMAL(9,2),
    PRIMARY KEY (HIST_ID)
);
