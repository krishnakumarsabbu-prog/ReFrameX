-- SYNTHETIC fixture DDL — account ledger database
CREATE TABLE ACCT.ACCOUNT (
    ACCT_NUM      CHAR(10)    NOT NULL,
    ACCT_TYPE     CHAR(3),
    HOLDER_NAME   VARCHAR(35),
    OPEN_DATE     DATE,
    CURR_BAL      DECIMAL(13,2),
    AVAIL_BAL     DECIMAL(13,2),
    STATUS        CHAR(1),
    BRANCH        CHAR(6),
    OFFICER       CHAR(8),
    PRIMARY KEY (ACCT_NUM)
);

CREATE TABLE ACCT.TRANSACTIONS (
    TRANS_ID      CHAR(15)   NOT NULL,
    ACCT_NUM      CHAR(10)   NOT NULL,
    TRANS_DATE    TIMESTAMP,
    TRANS_AMOUNT  DECIMAL(11,2),
    TRANS_TYPE    CHAR(3),
    TRANS_STATUS  CHAR(2),
    PRIMARY KEY (TRANS_ID)
);

CREATE INDEX ACCT.IDX_ACCT_STATUS
    ON ACCT.ACCOUNT (STATUS);

CREATE INDEX ACCT.IDX_TRANS_ACCT
    ON ACCT.TRANSACTIONS (ACCT_NUM);
