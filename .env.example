# ==============================================================================
# ReFrameX Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Storage and Database Paths
# ------------------------------------------------------------------------------
# Location for SQLite database file
REFRAMEX_DB_PATH=backend/reframex.db

# Location for ingested artifact storage
REFRAMEX_UPLOAD_DIR=backend/uploads

# Optional: Path to an allowlisted directory for batch folder ingestion
# Leave empty to disable local folder imports
M2O_METADATA_DIR=

# ------------------------------------------------------------------------------
# LLM Second-Opinion Evaluation Layer (Advisory only - Inferred evidence)
# ------------------------------------------------------------------------------
# Set to 'true' to enable LLM-assisted finding critique and hypothesis review
LLM_ENABLED=false

# Provider type: 'openai_compatible'
LLM_PROVIDER=openai_compatible

# Base URL for the OpenAI-compatible API
LLM_BASE_URL=https://api.groq.com/openai/v1

# API Key for LLM service (Required only if LLM_ENABLED=true)
LLM_API_KEY=

# Model name (e.g. llama-3.3-70b-versatile, gpt-4o-mini)
LLM_MODEL=llama-3.3-70b-versatile

# Strict egress allowlist: comma-separated hostnames permitted for outbound LLM calls
LLM_ALLOWED_HOSTS=api.groq.com,localhost,127.0.0.1

# Privacy & transmission mode: 'snippets' (lines around findings), 'structure_only', or 'full_artifact'
LLM_SEND_MODE=snippets

# Automatic regex redaction of SSNs, account numbers, credentials, and mainframe passwords
LLM_REDACT=true

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=30.0

# Retry attempts for transient 429/5xx errors
LLM_MAX_RETRIES=2
